<?xml version="1.0"?>
<!-- 22 mm octagonal bore for the 20 mm round peg. -->
<robot name="round_insertion_fixture_relaxed">
  <link name="fixture">
    <!-- The solid bottom preserves the original z=10 mm insertion stop. -->
    <visual><origin xyz="0 0 0.005"/><geometry><box size="0.22 0.22 0.01"/></geometry><material name="fixture"><color rgba="0.25 0.32 0.4 1"/></material></visual>
    <collision><origin xyz="0 0 0.005"/><geometry><box size="0.22 0.22 0.01"/></geometry></collision>

    <!-- Eight overlapping blocks form a guide around local (-0.05, 0).
         Their inner faces are 11 mm from the centre, providing 1 mm radial
         clearance while preserving contact and the original 45 mm depth. -->
    <visual><origin xyz="-0.035 0 0.0325" rpy="0 0 0"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.035 0 0.0325" rpy="0 0 0"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.039393 0.010607 0.0325" rpy="0 0 0.785398"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.039393 0.010607 0.0325" rpy="0 0 0.785398"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.05 0.015 0.0325" rpy="0 0 1.570796"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.05 0.015 0.0325" rpy="0 0 1.570796"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.060607 0.010607 0.0325" rpy="0 0 2.356194"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.060607 0.010607 0.0325" rpy="0 0 2.356194"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.065 0 0.0325" rpy="0 0 3.141593"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.065 0 0.0325" rpy="0 0 3.141593"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.060607 -0.010607 0.0325" rpy="0 0 -2.356194"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.060607 -0.010607 0.0325" rpy="0 0 -2.356194"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.05 -0.015 0.0325" rpy="0 0 -1.570796"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.05 -0.015 0.0325" rpy="0 0 -1.570796"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
    <visual><origin xyz="-0.039393 -0.010607 0.0325" rpy="0 0 -0.785398"/><geometry><box size="0.008 0.01243 0.045"/></geometry><material name="fixture"/></visual>
    <collision><origin xyz="-0.039393 -0.010607 0.0325" rpy="0 0 -0.785398"/><geometry><box size="0.008 0.01243 0.045"/></geometry></collision>
  </link>
</robot>
